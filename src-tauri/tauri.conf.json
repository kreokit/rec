{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KreoKit Rec",
  "version": "0.1.0",
  "identifier": "com.kreokit.rec",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1490",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KreoKit Rec",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
